#. type: Yaml Front Matter Hash Value: description
#: support/documentation/content/en/documentation/admin/advanced/_index.md
#, no-wrap
msgid "Some advanced features"
msgstr "Eginbide aurreratu batzuk"

#. type: Yaml Front Matter Hash Value: title
#: support/documentation/content/en/documentation/admin/advanced/_index.md
#, no-wrap
msgid "Advanced usage"
msgstr "Erabilera aurreratua"

#. type: Yaml Front Matter Hash Value: description
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
#, no-wrap
msgid "Using Matterbridge to bridge with other chats"
msgstr "Matterbridge erabiltzea beste txat batzuekin zubia egiteko"

#. type: Yaml Front Matter Hash Value: title
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
#, no-wrap
msgid "Using Matterbridge"
msgstr "Matterbridge erabiltzea"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "The following is based on a tutorial to use Matterbridge with the plugin: [Matterbridge + Peertube](https://gitlab.com/refrac/obs-matterbridge-overlay/-/blob/master/documentation/peertube.md)"
msgstr ""
"Hurrengoa Matterbridge osagarriarekin erabiltzeko tutorial batean "
"oinarrituta dago: [Matterbridge + Peertube](https://gitlab.com/refrac/obs-"
"matterbridge-overlay/-/blob/master/documentation/peertube.md)"

#. type: Title ##
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
#, no-wrap
msgid "Requirements"
msgstr "Baldintzak"

#. type: Bullet: '- '
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "[PeerTube plugin livechat](https://github.com/JohnXLivingston/peertube-plugin-livechat) version 3.2.0 or later."
msgstr ""
"[PeerTube plugin livechat](https://github.com/JohnXLivingston/peertube-"
"plugin-livechat) 3.2.0 bertsioa edo berriagoa."

#. type: Bullet: '- '
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "[Matterbridge](https://github.com/42wim/matterbridge) version 1.22.4 or later."
msgstr ""
"[Matterbridge](https://github.com/42wim/matterbridge) 1.22.4 bertsioa edo "
"berriagoa."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "The easiest is if the PeerTube instance and Matterbridge run on the same server."
msgstr ""
"Errazena PeerTube instantzia eta Matterbridge zerbitzari berean exekutatzea "
"da."

#. type: Title ##
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
#, no-wrap
msgid "Internal connections only (basic)"
msgstr "Barneko konexioak soilik (oinarrizkoa)"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "You will need to enable `{{% livechat_label prosody_c2s_label %}}` in the livechat plugin settings."
msgstr ""
"`{{% livechat_label prosody_c2s_label %}}` gaitu beharko duzu livechat "
"osagarriaren ezarpenetan."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "This will allow localhost XMPP clients to connect to the Prosody XMPP server."
msgstr ""
"Horrek localhost-eko XMPP bezeroei Prosody XMPP zerbitzarira konektatzeko "
"aukera emango die."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "You may need to add some line to your `/etc/hosts`:"
msgstr ""
"Baliteke lerro batzuk gehitu behar izatea zure `/etc/hosts` fitxategian:"

#. type: Fenced code block
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
#, no-wrap
msgid "127.0.0.1       anon.example.org room.example.org\n"
msgstr "127.0.0.1       anon.example.org room.example.org\n"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "Replace `example.org` by your actual instance domain name. Afterwards you can continue with the Matterbridge configuration below."
msgstr ""
"Ordeztu `example.org` zure instantziaren benetako domeinu-izenarekin. "
"Ondoren, beheko Matterbridge konfigurazioarekin jarrai dezakezu."

#. type: Title ##
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
#, no-wrap
msgid "Allow external connections (advanced)"
msgstr "Baimendu kanpoko konexioak (aurreratua)"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "By default, the internal Prosody XMPP server only listens on localhost (127.0.0.1)."
msgstr ""
"Lehenespenez, barneko Prosody XMPP zerbitzariak localhost-en (127.0.0.1) "
"soilik entzuten du."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
#, no-wrap
msgid "On livechat versions >= 10.1.0 a new option call `Client to server network interfaces` was added to allow changing this.\n"
msgstr ""
"Livechat >= 10.1.0 bertsioetan, `Client to server network interfaces` "
"izeneko aukera berri bat gehitu zen hori aldatu ahal izateko.\n"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "It allows to add a list of IPs to listen on, coma separated (spaces will be stripped)."
msgstr ""
"Entzun beharreko IPen zerrenda bat gehitzeko aukera ematen du, komaz "
"bereizita (zuriuneak kenduko dira)."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "You can also use `*` to listen on all IPv4 interfaces, and `::` for all IPv6. Doing so allows external access to the client to server interface."
msgstr ""
"`*` ere erabil dezakezu IPv4 interfaze guztiak entzuteko, eta `::` IPv6 "
"guztietarako. Horrela, kanpotik atzi daiteke bezerotik zerbitzarirako "
"interfazea."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "Then you need to open the C2S port (by default `52822`, but check the plugin settings to get the current value) in your firewall so that it can be reached from the internet.  If you don't want to use C2S connections for anything else than your Matterbridge service, you should restrict access to this port to your Matterbridge server IP."
msgstr ""
"Ondoren, C2S ataka ireki behar duzu zure suebakian (lehenespenez `52822`, "
"baina begiratu osagarriaren ezarpenak uneko balioa jakiteko), Internetetik "
"atzitu ahal izateko.  C2S konexioak zure Matterbridge zerbitzurako soilik "
"erabili nahi badituzu, ataka honetarako sarbidea zure Matterbridge "
"zerbitzariaren IPra mugatu beharko zenuke."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "You also need to add DNS records (A and AAAA) for `anon.example.org` and `room.example.org` (replace `example.org` by your actual domain name)."
msgstr ""
"DNS erregistroak (A eta AAAA) ere gehitu behar dituzu `anon.example.org` eta "
"`room.example.org` helbideetarako (ordeztu `example.org` zure benetako "
"domeinu-izenarekin)."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "In case you are using a port other than `5222` (XMPP standard port) you also need to set the [xmpp-client SRV record](https://prosody.im/doc/dns#srv_records) to the correct port."
msgstr ""
"`5222` (XMPP ataka estandarra) ez den beste ataka bat erabiltzen baduzu, "
"[xmpp-client SRV erregistroa](https://prosody.im/doc/dns#srv_records) ere "
"ataka zuzenera ezarri behar duzu."

#. type: Title ##
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
#, no-wrap
msgid "Configurating Matterbridge"
msgstr "Matterbridge konfiguratzea"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "In the version 1.22.4, Matterbridge added support for XMPP anonymous connections needed to connect to the built-in prosody."
msgstr ""
"1.22.4 bertsioan, Matterbridgek XMPP konexio anonimoetarako euskarria gehitu "
"zuen, barneko Prosodyra konektatzeko beharrezkoa dena."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "So in the TOML config file put:"
msgstr "Beraz, TOML konfigurazio-fitxategian jarri hau:"

#. type: Fenced code block (TOML)
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
#, no-wrap
msgid ""
"[xmpp.mypeertube]\n"
"Anonymous=true\n"
"Server=\"anon.example.org:52822\"\n"
"Muc=\"room.example.org\"\n"
"Nick=\"Matterbridge\"\n"
"RemoteNickFormat=\"[{PROTOCOL}] <{NICK}> \"\n"
"NoTLS=true\n"
msgstr ""
"[xmpp.mypeertube]\n"
"Anonymous=true\n"
"Server=\"anon.example.org:52822\"\n"
"Muc=\"room.example.org\"\n"
"Nick=\"Matterbridge\"\n"
"RemoteNickFormat=\"[{PROTOCOL}] <{NICK}> \"\n"
"NoTLS=true\n"

#. type: Bullet: '- '
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "Replace `example.org` by your actual instance domain name."
msgstr "Ordeztu `example.org` zure instantziaren benetako domeinu-izenarekin."

#. type: Bullet: '- '
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "Replace `52822` by the actual port if you changed it."
msgstr "Ordeztu `52822` benetako atakarekin, aldatu baduzu."

#. type: Bullet: '- '
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "`mypeertube` can be replaced by another name."
msgstr "`mypeertube` beste izen batekin ordez daiteke."

#. type: Bullet: '- '
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "Using `peertube` as the Nick will provide put PeerTube icon for overlay messages, can be also done with overlay config modification."
msgstr ""
"`peertube` Nick gisa erabiliz gero, PeerTube ikonoa jarriko da gainjarritako "
"mezuetan; gainjartzearen konfigurazioa aldatuz ere egin daiteke."

#. type: Bullet: '- '
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "The setting `NoTLS=true` allows connecting to a server with self-signed certificates."
msgstr ""
"`NoTLS=true` ezarpenak auto-sinatutako ziurtagiriak dituen zerbitzari batera "
"konektatzeko aukera ematen du."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "Now you can add this account to gateways and bridge specific live-chat channels."
msgstr ""
"Orain kontu hau pasabideei gehi diezaiekezu, eta livechat kanal jakinak "
"zubitu."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/matterbridge.md
msgid "This documentation use an anonymous account to connect the bridge to the chat.  But since the livechat v10.1.0, there is a new way to generate long term authentication token, that allows to connect using your account.  This is used for [OBS docks](/peertube-plugin-livechat/documentation/user/obs).  Using this feature for other purposes is not documented and not officially supported yet.  If you want to use it anyway, you can request a token by calling then `/plugins/livechat/router/api/auth/tokens` endpoint.  To get needed headers and request body, just check what happens when you generate a new token for OBS docks."
msgstr ""
"Dokumentazio honek kontu anonimo bat erabiltzen du zubia txatera "
"konektatzeko.  Baina livechat v10.1.0 bertsiotik, iraupen luzeko "
"autentifikazio-tokenak sortzeko modu berri bat dago, zure kontua erabiliz "
"konektatzeko aukera ematen duena.  [OBS paneletarako](/peertube-plugin-"
"livechat/documentation/user/obs) erabiltzen da.  Eginbide hau beste helburu "
"batzuetarako erabiltzea ez dago dokumentatuta, ezta ofizialki onartuta ere "
"oraingoz.  Hala ere erabili nahi baduzu, token bat eska dezakezu `/plugins/"
"livechat/router/api/auth/tokens` amaiera-puntua deituz.  Beharrezko "
"goiburuak eta eskaeraren gorputza lortzeko, begiratu zer gertatzen den OBS "
"paneletarako token berri bat sortzen duzunean."

#. type: Yaml Front Matter Hash Value: description
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "Allow connections using XMPP clients"
msgstr "Baimendu konexioak XMPP bezeroak erabiliz"

#. type: Yaml Front Matter Hash Value: title
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "XMPP clients"
msgstr "XMPP bezeroak"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "This chat module is based on the XMPP protocol, also known as Jabber.  It is therefore possible to connect to the chats using [XMPP client software](https://en.wikipedia.org/wiki/XMPP#Clients).  This can for example be useful to facilitate moderation operations."
msgstr ""
"Txat-modulu hau XMPP protokoloan oinarrituta dago, Jabber izenez ere "
"ezaguna.  Beraz, txatetara konekta daiteke [XMPP bezero-softwarea](https://"
"en.wikipedia.org/wiki/XMPP#Clients) erabiliz.  Hori erabilgarria izan "
"daiteke, adibidez, moderazio-eragiketak errazteko."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "For the user documentation associated with these features, please refer to the [user documentation page](/peertube-plugin-livechat/documentation/user/xmpp_clients/)."
msgstr ""
"Eginbide hauei lotutako erabiltzaile-dokumentaziorako, ikusi [erabiltzaile-"
"dokumentazioaren orria](/peertube-plugin-livechat/documentation/user/"
"xmpp_clients/)."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Enabling these features requires configuration changes on the server, and on the DNS records.  It is not possible to configure this only from the Peertube interface, and it requires some basic system some basic system admin skills."
msgstr ""
"Eginbide hauek gaitzeko, konfigurazio-aldaketak egin behar dira zerbitzarian "
"eta DNS erregistroetan.  Ezin da PeerTuberen interfazetik soilik "
"konfiguratu, eta sistema-administrazioko oinarrizko trebetasun batzuk behar "
"dira."

#. type: Title ##
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#: support/documentation/content/en/documentation/user/xmpp_clients.md
#, no-wrap
msgid "Login to your Peertube account"
msgstr "Hasi saioa zure PeerTube kontuan"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#: support/documentation/content/en/documentation/user/xmpp_clients.md
msgid "This feature is not yet available, and will come in a future version of the plugin."
msgstr ""
"Eginbide hau ez dago oraindik erabilgarri, eta osagarriaren etorkizuneko "
"bertsio batean etorriko da."

#. type: Title ##
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#: support/documentation/content/en/documentation/user/xmpp_clients.md
#, no-wrap
msgid "Connection using an external XMPP account"
msgstr "Kanpoko XMPP kontu bat erabiliz konektatzea"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "To enable this feature, you will need to set up your server and DNS records, so that XMPP clients can find and access the [Prosody server](https://prosody.im) that this plugin uses internally."
msgstr ""
"Eginbide hau gaitzeko, zure zerbitzaria eta DNS erregistroak konfiguratu "
"beharko dituzu, XMPP bezeroek osagarri honek barnean erabiltzen duen "
"[Prosody zerbitzaria](https://prosody.im) aurkitu eta atzitu ahal izan "
"dezaten."

#. type: Title ###
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "Plugin settings"
msgstr "Osagarriaren ezarpenak"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Start by going to the livechat plugin settings of your instance, then enable the setting \"Enable connection to room using external XMPP accounts\".  By checking this setting, new settings appear below."
msgstr ""
"Hasteko, joan zure instantziako livechat osagarriaren ezarpenetara, eta "
"gaitu \"Gaitu geletara kanpoko XMPP kontuekin konektatzea\" ezarpena.  "
"Ezarpen hau markatuz gero, ezarpen berriak agertuko dira behean."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "First of all, the \"Prosody server to server port\" field.  This one defaults to 5269, which is the standard port for this service.  You can however change to another port, if this is already in use on your server."
msgstr ""
"Lehenik, \"Prosodyren zerbitzaritik zerbitzarirako ataka\" eremua.  "
"Lehenespenez 5269 da, zerbitzu honetarako ataka estandarra.  Hala ere, beste "
"ataka batera alda dezakezu, zure zerbitzarian dagoeneko erabiltzen ari bada."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Next, the field \"Server to server network interfaces\" field allows you to specify which network interfaces the server should listen on.  The default value \"*, ::\" indicates to listen on all IP addresses.  You can change these values, if you wish to listen on only certain IP addresses.  The syntax is explained next to the setting."
msgstr ""
"Ondoren, \"Zerbitzaritik zerbitzarirako sare-interfazeak\" eremuak "
"zerbitzariak zein sare-interfazetan entzun behar duen zehazteko aukera "
"ematen du.  \"*, ::\" balio lehenetsiak IP helbide guztietan entzun behar "
"dela adierazten du.  Balio horiek alda ditzakezu, IP helbide jakin batzuetan "
"soilik entzun nahi baduzu.  Sintaxia ezarpenaren ondoan azaltzen da."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "For the \"Certificate folder\" setting, you can leave it empty.  In this case, the plugin will automatically generate self-signed certificates.  Some XMPP servers may refuse to connect, depending on their configuration.  In this case, you can indicate here a path on the server, in which you must place certificates to be used by the module.  It is up to you to generate and renew them.  See bellow for more information."
msgstr ""
"\"Ziurtagirien karpeta\" ezarpena hutsik utz dezakezu.  Kasu horretan, "
"osagarriak auto-sinatutako ziurtagiriak sortuko ditu automatikoki.  XMPP "
"zerbitzari batzuek konektatzeari uko egin diezaiokete, beren "
"konfigurazioaren arabera.  Kasu horretan, zerbitzariko bide bat adieraz "
"dezakezu hemen, eta bertan jarri beharko dituzu moduluak erabiliko dituen "
"ziurtagiriak.  Zure ardura da haiek sortzea eta berritzea.  Ikusi behean "
"informazio gehiagorako."

#. type: Title ###
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "Firewall"
msgstr "Suebakia"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "You must open the configured port (5269 by default) on your firewall."
msgstr ""
"Konfiguratutako ataka (lehenespenez 5269) ireki behar duzu zure suebakian."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "If you are using Docker for your Peertube, you need to modify the `docker-compose.yml` file to open port 5269 of the `peertube` container, so that the outer world can connect to it."
msgstr ""
"Zure PeerTuberako Docker erabiltzen baduzu, `docker-compose.yml` fitxategia "
"aldatu behar duzu `peertube` edukiontziaren 5269 ataka irekitzeko, kanpotik "
"hartara konektatu ahal izateko."

#. type: Title ###
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "DNS"
msgstr "DNS"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "You need to add [DNS records](https://prosody.im/doc/dns) allowing remote servers to find \"room.your_instance.tld\" and \"external.your_instance.tld\" components."
msgstr ""
"[DNS erregistroak](https://prosody.im/doc/dns) gehitu behar dituzu, urruneko "
"zerbitzariek \"room.your_instance.tld\" eta \"external.your_instance.tld\" "
"osagaiak aurki ditzaten."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "The easiest way to do this is to add SRV records for the \"room\" and \"external\" [subdomain](https://prosody.im/doc/dns#subdomains):"
msgstr ""
"Hori egiteko modurik errazena \"room\" eta \"external\" [azpidomeinuetarako]"
"(https://prosody.im/doc/dns#subdomains) SRV erregistroak gehitzea da:"

#. type: Bullet: '* '
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "record name: _xmpp-server._tcp.room.your_instance.tld. (replace «your_instance.tld» by your instance uri)"
msgstr ""
"erregistroaren izena: _xmpp-server._tcp.room.your_instance.tld. (ordeztu «"
"your_instance.tld» zure instantziaren URIarekin)"

#. type: Bullet: '* '
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "TTL: 3600"
msgstr "TTL: 3600"

#. type: Bullet: '* '
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "class: IN"
msgstr "klasea: IN"

#. type: Bullet: '* '
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "SRV: 0"
msgstr "SRV: 0"

#. type: Bullet: '* '
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "priority: 0"
msgstr "lehentasuna: 0"

#. type: Bullet: '* '
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "weight: 5"
msgstr "pisua: 5"

#. type: Bullet: '* '
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "port: 5269 (adapt if your changed the default port)"
msgstr "ataka: 5269 (egokitu ataka lehenetsia aldatu baduzu)"

#. type: Bullet: '* '
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "target: your_instance.tld. (replace by your instance uri)"
msgstr "helburua: your_instance.tld. (ordeztu zure instantziaren URIarekin)"

#. type: Bullet: '* '
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "record name: _xmpp-server._tcp.external.your_instance.tld. (replace «your_instance.tld» by your instance uri)"
msgstr ""
"erregistroaren izena: _xmpp-server._tcp.external.your_instance.tld. (ordeztu "
"«your_instance.tld» zure instantziaren URIarekin)"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Be careful to keep the dot after \"your_instance.tld\"."
msgstr "Kontuz \"your_instance.tld\" ondorengo puntua mantentzeko."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Using the `dig` command to check your records, you should get a result similar to this:"
msgstr ""
"`dig` komandoa erabiliz zure erregistroak egiaztatzean, honen antzeko "
"emaitza lortu beharko zenuke:"

#. type: Fenced code block (bash)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid ""
"$ dig +short _xmpp-server._tcp.room.videos.john-livingston.fr. SRV\n"
"0 5 5269 videos.john-livingston.fr.\n"
"\n"
"$ dig +short _xmpp-server._tcp.external.videos.john-livingston.fr. SRV\n"
"0 5 5269 videos.john-livingston.fr.\n"
msgstr ""
"$ dig +short _xmpp-server._tcp.room.videos.john-livingston.fr. SRV\n"
"0 5 5269 videos.john-livingston.fr.\n"
"\n"
"$ dig +short _xmpp-server._tcp.external.videos.john-livingston.fr. SRV\n"
"0 5 5269 videos.john-livingston.fr.\n"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "If you are **not using the standard `5269` port**, you must also add a SRV record for `_xmpp-server._tcp.your_instance.tld.` (same as above, just without the `room.` prefix).  Of course, you can also add this record if you use the standard port. It will also work."
msgstr ""
"**`5269` ataka estandarra erabiltzen ez baduzu**, SRV erregistro bat ere "
"gehitu behar duzu `_xmpp-server._tcp.your_instance.tld.` helbiderako "
"(goikoaren berdina, `room.` aurrizkirik gabe).  Jakina, erregistro hau gehi "
"dezakezu ataka estandarra erabiltzen baduzu ere. Horrela ere funtzionatuko "
"du."

#. type: Title ###
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "Using trusted certificates"
msgstr "Ziurtagiri fidagarriak erabiltzea"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "The self-signed certificates that this plugin uses by default can be rejected by some XMPP servers, for security reasons."
msgstr ""
"Osagarri honek lehenespenez erabiltzen dituen auto-sinatutako ziurtagiriak "
"baztertu egin ditzakete XMPP zerbitzari batzuek, segurtasun-arrazoiengatik."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "It is possible to use certificates validated by a certification authority.  However, this requires advanced system administration knowledge.  Indeed, due to the multitude of possible use cases, it is impossible to document all situations here.  This documentation will therefore only explain the goal to be reached, and give an example which will only be suitable for a \"basic\" situation (manual installation of Peertube, using letsencrypt).  If you are in another situation (Docker installation, certificates signed by another authority, etc...), you will have to adapt this approach by yourself."
msgstr ""
"Ziurtagiri-agintaritza batek baliozkotutako ziurtagiriak erabil daitezke.  "
"Hala ere, horrek sistema-administrazioko ezagutza aurreratuak eskatzen "
"ditu.  Izan ere, erabilera-kasu posible asko daudenez, ezinezkoa da egoera "
"guztiak hemen dokumentatzea.  Beraz, dokumentazio honek lortu beharreko "
"helburua baino ez du azalduko, eta egoera \"oinarrizko\" baterako soilik "
"egokia izango den adibide bat emango du (PeerTuberen eskuzko instalazioa, "
"letsencrypt erabiliz).  Beste egoera batean bazaude (Docker instalazioa, "
"beste agintaritza batek sinatutako ziurtagiriak, etab.), zuk zeuk egokitu "
"beharko duzu planteamendu hau."

#. type: Title ####
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "Basic principle"
msgstr "Oinarrizko printzipioa"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "It is up to you to generate valid certificates for domains `your_instance.tld` and `room.your_instance.tld`.  You can use any [method supported by Prosody](https://prosody.im/doc/certificates)."
msgstr ""
"Zure ardura da `your_instance.tld` eta `room.your_instance.tld` "
"domeinuetarako baliozko ziurtagiriak sortzea.  [Prosodyk onartzen duen]"
"(https://prosody.im/doc/certificates) edozein metodo erabil dezakezu."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "You must then place these certificates in a folder that will be accessible to the `peertube` user, and specify this folder in the plugin setting \"Certificate folder\"."
msgstr ""
"Ondoren, ziurtagiri horiek `peertube` erabiltzaileak atzi dezakeen karpeta "
"batean jarri behar dituzu, eta karpeta hori zehaztu osagarriaren "
"\"Ziurtagirien karpeta\" ezarpenean."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "If you want to use the ProsodyCtl utility to import certificates, this utility is available (once Peertube is started) using the following command (adapting the path to your Peertube data folder, and replacing \"xxx\" with the arguments you wish to pass to prosodyctl): `sudo -u peertube /var/www/peertube/storage/plugins/data/peertube-plugin-livechat/prosodyAppImage/squashfs-root/AppRun prosodyctl --config /var/www/peertube/storage/plugins/data/peertube-plugin-livechat/prosody/prosody.cfg.lua xxx`"
msgstr ""
"ProsodyCtl tresna erabili nahi baduzu ziurtagiriak inportatzeko, tresna hori "
"erabilgarri dago (PeerTube abiarazi ondoren) komando hau erabiliz (zure "
"PeerTube datu-karpetaren bidea egokituz, eta \"xxx\" prosodyctl-i pasatu "
"nahi dizkiozun argumentuekin ordeztuz): `sudo -u peertube /var/www/peertube/"
"storage/plugins/data/peertube-plugin-livechat/prosodyAppImage/squashfs-root/"
"AppRun prosodyctl --config /var/www/peertube/storage/plugins/data/peertube-"
"plugin-livechat/prosody/prosody.cfg.lua xxx`"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "The plugin will check once a day to see if any files have been modified in this folder, and reload Prosody if necessary."
msgstr ""
"Osagarriak egunean behin egiaztatuko du karpeta honetako fitxategiren bat "
"aldatu den, eta Prosody birkargatuko du beharrezkoa bada."

#. type: Title ####
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "Method for the simple case"
msgstr "Kasu errazerako metodoa"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "We assume here that your Peertube installation is \"classic\" (no use of Docker), and that the certificates are generated by letsencrypt, using the certbot tool."
msgstr ""
"Hemen suposatzen dugu zure PeerTube instalazioa \"klasikoa\" dela (Docker "
"erabili gabe), eta ziurtagiriak letsencrypt-ek sortzen dituela, certbot "
"tresna erabiliz."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "First of all, we'll have to create a certificate for the subdomain `room.your_instance.tld` : this is the uri of the MUC (XMPP chat rooms) component.  Even if the connections are made on `your_instance.tld`, we will need a valid certificate for this subdomain."
msgstr ""
"Lehenik eta behin, `room.your_instance.tld` azpidomeinurako ziurtagiri bat "
"sortu beharko dugu: hau da MUC (XMPP txat-gelak) osagaiaren URIa.  Konexioak "
"`your_instance.tld` helbidean egiten badira ere, azpidomeinu honetarako "
"baliozko ziurtagiri bat beharko dugu."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "So start by setting up a DNS entry for `room.your_instance.tld`, which points to your server.  You can use a CNAME entry (or an A entry and a AAAA entry)."
msgstr ""
"Beraz, hasi `room.your_instance.tld` helbiderako DNS sarrera bat "
"konfiguratuz, zure zerbitzarira seinalatzen duena.  CNAME sarrera bat erabil "
"dezakezu (edo A sarrera bat eta AAAA sarrera bat)."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Next, we'll use nginx (already installed for your Peertube) to generate the certbot certificate.  We will create a new site. In the file `/etc/nginx/site-available/room.peertube`, add:"
msgstr ""
"Ondoren, nginx erabiliko dugu (zure PeerTuberako dagoeneko instalatuta "
"dagoena) certbot ziurtagiria sortzeko.  Gune berri bat sortuko dugu. `/etc/"
"nginx/site-available/room.peertube` fitxategian, gehitu hau:"

#. type: Fenced code block (nginx)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid ""
"server {\n"
"  listen 80;\n"
"  listen [::]:80;\n"
"  server_name room.your_instance.tld;\n"
"\n"
"  location /.well-known/acme-challenge/ {\n"
"    default_type \"text/plain\";\n"
"    root /var/www/certbot;\n"
"  }\n"
"  location / { return 301 https://your_instance.tld; }\n"
"}\n"
msgstr ""
"server {\n"
"  listen 80;\n"
"  listen [::]:80;\n"
"  server_name room.your_instance.tld;\n"
"\n"
"  location /.well-known/acme-challenge/ {\n"
"    default_type \"text/plain\";\n"
"    root /var/www/certbot;\n"
"  }\n"
"  location / { return 301 https://your_instance.tld; }\n"
"}\n"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Then enable the site:"
msgstr "Ondoren, gaitu gunea:"

#. type: Fenced code block (bash)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid ""
"ln -s /etc/nginx/sites-available/room.peertube /etc/nginx/sites-enabled/\n"
"systemc reload nginx\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Then we prepare the folder in which we will later import the certificates.  We assume here that you already have the plugin active. We will create the following folder (if it doesn't already exist), with the user `peertube` to make sure there are no permissions issues:"
msgstr ""
"Ondoren, geroago ziurtagiriak inportatuko ditugun karpeta prestatuko dugu.  "
"Hemen suposatzen dugu osagarria dagoeneko aktibo duzula. Karpeta hau sortuko "
"dugu (lehendik ez badago), `peertube` erabiltzailearekin, baimen-arazorik ez "
"dagoela ziurtatzeko:"

#. type: Fenced code block (bash)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "sudo -u peertube mkdir /var/www/peertube/storage/plugins/data/peertube-plugin-livechat/prosody/certs\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Now you have to configure this folder in the plugin settings, for the parameter \"Certificate folders\".  It's important to do this now, otherwise the certificate import script will put the certificates in the wrong folder."
msgstr ""
"Orain karpeta hau konfiguratu behar duzu osagarriaren ezarpenetan, "
"\"Ziurtagirien karpeta\" parametrorako.  Garrantzitsua da orain egitea; "
"bestela, ziurtagiriak inportatzeko scriptak ziurtagiriak karpeta okerrean "
"jarriko ditu."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "We will configure certbot to import the generated certificates into the Prosody folder.  We can use the ProsodyCtl utility packaged in the plugin."
msgstr ""
"Certbot konfiguratuko dugu sortutako ziurtagiriak Prosody karpetara inporta "
"ditzan.  Osagarrian paketatutako ProsodyCtl tresna erabil dezakegu."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Note: for it to be available, the plugin must have been started at least once."
msgstr ""
"Oharra: erabilgarri egon dadin, osagarria gutxienez behin abiarazi behar da."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "We will create a file `/etc/letsencrypt/renewal-hooks/deploy/prosody.sh` containing:"
msgstr ""
"`/etc/letsencrypt/renewal-hooks/deploy/prosody.sh` fitxategi bat sortuko "
"dugu, eduki honekin:"

#. type: Fenced code block (bash)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid ""
"#!/usr/bin/env sh\n"
"/var/www/peertube/storage/plugins/data/peertube-plugin-livechat/prosodyAppImage/squashfs-root/AppRun prosodyctl \\\n"
"  --root \\\n"
"  --config /var/www/peertube/storage/plugins/data/peertube-plugin-livechat/prosody/prosody.cfg.lua \\\n"
"  cert import \\\n"
"  room.your_instance.tld your_instance.tld /etc/letsencrypt/live\n"
msgstr ""
"#!/usr/bin/env sh\n"
"/var/www/peertube/storage/plugins/data/peertube-plugin-livechat/"
"prosodyAppImage/squashfs-root/AppRun prosodyctl \\\n"
"  --root \\\n"
"  --config /var/www/peertube/storage/plugins/data/peertube-plugin-livechat/"
"prosody/prosody.cfg.lua \\\n"
"  cert import \\\n"
"  room.your_instance.tld your_instance.tld /etc/letsencrypt/live\n"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Then we ask to generate the certificate:"
msgstr "Ondoren, ziurtagiria sortzeko eskatuko dugu:"

#. type: Fenced code block (bash)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "certbot -d room.videos.john-livingston.fr\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "If certbot offers you several methods to generate the certificate, choose \"nginx\"."
msgstr ""
"Certbotek ziurtagiria sortzeko hainbat metodo eskaintzen badizkizu, aukeratu "
"\"nginx\"."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Normally you should now find the certificates in the configured folder."
msgstr ""
"Normalean, orain ziurtagiriak konfiguratutako karpetan aurkitu beharko "
"zenituzke."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Note: the first time you do this, you will have to reload Prosody. The easiest way to do this is to restart Peertube."
msgstr ""
"Oharra: hau lehen aldiz egiten duzunean, Prosody birkargatu beharko duzu. "
"Modurik errazena PeerTube berrabiaraztea da."

#. type: Title ####
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "Method for the Docker case"
msgstr "Docker kasurako metodoa"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "This method works with the officially supported [Docker guide](https://docs.joinpeertube.org/install/docker) from PeerTube."
msgstr ""
"Metodo honek PeerTuberen ofizialki onartutako [Docker gidarekin](https://"
"docs.joinpeertube.org/install/docker) funtzionatzen du."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "First, ensure you create a DNS entry for `room.your_instance.tld`, which points to your server.  You can use a CNAME entry (or an A entry and a AAAA entry).  This is necessary for Let's Encrypt to validate the domain for certificate generation."
msgstr ""
"Lehenik, ziurtatu `room.your_instance.tld` helbiderako DNS sarrera bat "
"sortzen duzula, zure zerbitzarira seinalatzen duena.  CNAME sarrera bat "
"erabil dezakezu (edo A sarrera bat eta AAAA sarrera bat).  Beharrezkoa da "
"Let's Encrypt-ek domeinua baliozkotu dezan ziurtagiria sortzeko."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Enter the directory where your `docker-compose.yml` file exists."
msgstr "Sartu zure `docker-compose.yml` fitxategia dagoen direktorioan."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Open a shell in the certbot container:"
msgstr "Ireki shell bat certbot edukiontzian:"

#. type: Fenced code block (bash)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "docker exec -it certbot /bin/sh\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Run certbot:"
msgstr "Exekutatu certbot:"

#. type: Fenced code block (bash)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "certbot\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "You will be presented with a series of prompts. Enter `2` for the authentication type:"
msgstr "Galdera batzuk egingo zaizkizu. Sartu `2` autentifikazio motarako:"

#. type: Fenced code block (text)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid ""
"How would you like to authenticate with the ACME CA?\n"
"Select the appropriate number [1-2] then [enter] (press 'c' to cancel): 2\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Enter the domain name `room.your_instance.tld`:"
msgstr "Sartu `room.your_instance.tld` domeinu-izena:"

#. type: Fenced code block (text)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "Please enter the domain name(s) you would like on your certificate (comma and/or space separated) (Enter 'c' to cancel): room.your_instance.tld\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Enter the directory where the PeerTube webserver serves requests for Let's Encrypt, `/var/www/certbot`:"
msgstr ""
"Sartu PeerTube web-zerbitzariak Let's Encrypt-en eskaerak zerbitzatzen "
"dituen direktorioa, `/var/www/certbot`:"

#. type: Fenced code block (text)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "Input the webroot for <room.your_instance.tld>: (Enter 'c' to cancel): /var/www/certbot\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "You should see output like the following:"
msgstr "Honen antzeko irteera bat ikusi beharko zenuke:"

#. type: Fenced code block (text)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid ""
"Successfully received certificate.\n"
"Certificate is saved at: /etc/letsencrypt/live/room.your_instance.tld/fullchain.pem\n"
"Key is saved at:         /etc/letsencrypt/live/room.your_instance.tld/privkey.pem\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Run the below command inside the certbot container to give read access to the new certs and private keys to the peertube group.  *Note*: This will also make the files readable to the group with id 999 on the host system.  Check the groups on your system to assess this as a risk before running this command."
msgstr ""
"Exekutatu beheko komandoa certbot edukiontziaren barruan, ziurtagiri "
"berrietarako eta gako pribatuetarako irakurtzeko sarbidea emateko peertube "
"taldeari.  *Oharra*: horrek fitxategiak irakurgarri ere egingo ditu ostalari-"
"sistemako 999 IDa duen taldearentzat.  Begiratu zure sistemako taldeak, "
"arriskutsua den ebaluatzeko, komando hau exekutatu aurretik."

#. type: Fenced code block (bash)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid ""
"chown -R root:999 /etc/letsencrypt/live; \\\n"
"chmod 750 /etc/letsencrypt/live; \\\n"
"chown -R root:999 /etc/letsencrypt/archive; \\\n"
"chmod 750 /etc/letsencrypt/archive; \\\n"
"find /etc/letsencrypt/ -name 'privkey*' -exec chmod 0640 {} \\;\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Exit the certbot container:"
msgstr "Irten certbot edukiontzitik:"

#. type: Fenced code block (bash)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "exit\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Modify your `docker-compose.yml` file, changing the `entrypoint` line under the `certbot` service to the following.  This is the same as the above, but to be automatically executed after every certificate renewal."
msgstr ""
"Aldatu zure `docker-compose.yml` fitxategia, `certbot` zerbitzuaren azpiko "
"`entrypoint` lerroa honela aldatuz.  Goikoaren berdina da, baina ziurtagiria "
"berritzen den bakoitzean automatikoki exekutatzeko."

#. type: Fenced code block (text)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "  entrypoint: /bin/sh -c \"trap exit TERM; while :; do certbot renew --webroot -w /var/www/certbot; chown -R root:999 /etc/letsencrypt/live; chmod 750 /etc/letsencrypt/live; chown -R root:999 /etc/letsencrypt/archive; chmod 750 /etc/letsencrypt/archive; find /etc/letsencrypt/ -name 'privkey*' -exec chmod 0640 {} +; sleep 12h & wait $${!}; done;\"\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Continuing to modify `docker-compose.yml`, add the certbot certificate volume into the peertube container.  It should look something like this:"
msgstr ""
"`docker-compose.yml` aldatzen jarraituz, gehitu certbot ziurtagirien "
"bolumena peertube edukiontzian.  Honen antzekoa izan beharko luke:"

#. type: Fenced code block (text)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid ""
"  volumes:\n"
"    - ./docker-volume/certbot/conf:/etc/letsencrypt\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Restart your services:"
msgstr "Berrabiarazi zure zerbitzuak:"

#. type: Fenced code block (bash)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "docker-compose down; docker-comopse up -d\n"
msgstr ""

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "In the livechat plugin settings from your PeerTube administration settings, set the certificate directory to the following:"
msgstr ""
"Zure PeerTube administrazio-ezarpenetako livechat osagarriaren ezarpenetan, "
"ezarri ziurtagirien direktorioa honela:"

#. type: Fenced code block (text)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid "/etc/letsencrypt/live\n"
msgstr "/etc/letsencrypt/live\n"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "Save the plugin settings and verify Prosody can see the certificates:"
msgstr ""
"Gorde osagarriaren ezarpenak eta egiaztatu Prosodyk ziurtagiriak ikusten "
"dituela:"

#. type: Fenced code block (bash)
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#, no-wrap
msgid ""
"docker-compose exec -u peertube \\\n"
"  peertube \\\n"
"  /data/plugins/data/peertube-plugin-livechat/prosodyAppImage/squashfs-root/AppRun \\\n"
"  prosodyctl \\\n"
"  --config /data/plugins/data/peertube-plugin-livechat/prosody/prosody.cfg.lua \\\n"
"  check certs\n"
msgstr ""

#. type: Yaml Front Matter Hash Value: title
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
#: build/documentation/pot_in/documentation/admin/external_auth.md
#: support/documentation/content/en/documentation/installation/troubleshooting.md
#, no-wrap
msgid "Troubleshooting"
msgstr "Arazoak konpontzea"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/advanced/xmpp_clients.md
msgid "If you can't make it work, you can use the diagnostic tool (there is a button on top of the plugin settings page), and take a close look on the «Prosody check» section."
msgstr ""
"Ezin baduzu funtzionarazi, diagnostiko-tresna erabil dezakezu (botoi bat "
"dago osagarriaren ezarpen-orriaren goialdean), eta arretaz begiratu «Prosody "
"check» atala."

#. type: Yaml Front Matter Hash Value: description
#: build/documentation/pot_in/documentation/admin/external_auth.md
#, no-wrap
msgid "Plugin Peertube Livechat settings - External Authentication"
msgstr "PeerTube Livechat osagarriaren ezarpenak - Kanpoko autentifikazioa"

#. type: Title ##
#: build/documentation/pot_in/documentation/admin/external_auth.md
#: build/documentation/pot_in/documentation/admin/settings.md
#, no-wrap
msgid "External Authentication"
msgstr "Kanpoko autentifikazioa"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "Users that are not connected to your Peertube instance are joining the chat using \"anonymous accounts\" (they can freely choose a nickname, and will be assigned a random avatar)."
msgstr ""
"Zure PeerTube instantzian konektatuta ez dauden erabiltzaileak \"kontu "
"anonimoak\" erabiliz sartzen dira txatera (ezizen bat libreki aukera "
"dezakete, eta ausazko abatar bat esleituko zaie)."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "You can enable some external authentication methods to allow user to create chat accounts.  In such case their nickname and avatar will be automatically initialized with the remote account information."
msgstr ""
"Kanpoko autentifikazio-metodo batzuk gai ditzakezu, erabiltzaileek txat-"
"kontuak sor ditzaten.  Kasu horretan, haien ezizena eta abatarra "
"automatikoki hasieratuko dira urruneko kontuaren informazioarekin."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "Such \"external account users\" will be easier to moderate than anonymous accounts."
msgstr ""
"\"Kanpoko kontuko erabiltzaile\" horiek errazago moderatuko dira kontu "
"anonimoak baino."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "This also allows user to join the chat without creating Peertube account (in case your instance has closed registration for example, or without waiting for account approval)."
msgstr ""
"Horri esker, erabiltzaileak txatera sar daitezke PeerTube konturik sortu "
"gabe (adibidez, zure instantziak izen-ematea itxita badu, edo kontuaren "
"onarpenaren zain egon gabe)."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
#: support/documentation/content/en/documentation/user/viewers.md
msgid "![Screenshot of a Peertube video page, with a chat on the right. At the bottom of the chat, there is a \"{{% livechat_label login_using_external_account %}}\" button.](/peertube-plugin-livechat/images/external_login_button.png?classes=shadow,border&height=200px \"{{% livechat_label login_using_external_account %}} button\")"
msgstr ""
"![PeerTube bideo-orri baten pantaila-argazkia, txat bat eskuinean duela. "
"Txataren behealdean, \"{{% livechat_label login_using_external_account %}}\" "
"botoi bat dago.](/peertube-plugin-livechat/images/"
"external_login_button.png?classes=shadow,border&height=200px \"{{% "
"livechat_label login_using_external_account %}} botoia\")"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
#: support/documentation/content/en/documentation/user/viewers.md
msgid "![Screenshot of a dialog with an \"OpenID Connect\" button.](/peertube-plugin-livechat/images/external_login_dialog_oidc.png?classes=shadow,border&height=200px \"External login dialog - OpenID Connect\")"
msgstr ""
"![\"OpenID Connect\" botoia duen elkarrizketa-koadro baten pantaila-"
"argazkia.](/peertube-plugin-livechat/images/"
"external_login_dialog_oidc.png?classes=shadow,border&height=200px \"Kanpoko "
"saio-hasierako elkarrizketa-koadroa - OpenID Connect\")"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "This page will describe available authentication methods."
msgstr ""
"Orri honek eskuragarri dauden autentifikazio-metodoak deskribatuko ditu."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "For the user documentation, see [user documentation](/peertube-plugin-livechat/documentation/user/viewers/)"
msgstr ""
"Erabiltzaile-dokumentaziorako, ikusi [erabiltzaile-dokumentazioa](/peertube-"
"plugin-livechat/documentation/user/viewers/)"

#. type: Title ##
#: build/documentation/pot_in/documentation/admin/external_auth.md
#, no-wrap
msgid "OpenID Connect"
msgstr "OpenID Connect"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
#, no-wrap
msgid ""
"This feature is still experimental.\n"
"This feature is available with the plugin version >= 9.0.0.\n"
msgstr ""
"Eginbide hau esperimentala da oraindik.\n"
"Eginbide hau osagarriaren >= 9.0.0 bertsioarekin dago erabilgarri.\n"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "You can configure one external [OpenID Connect](https://openid.net/developers/how-connect-works/) compatible provider."
msgstr ""
"[OpenID Connect](https://openid.net/developers/how-connect-works/) "
"protokoloarekin bateragarria den kanpoko hornitzaile bat konfigura dezakezu."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "Doing so, you can for example use your website for Single Sign-On."
msgstr ""
"Horrela, adibidez, zure webgunea erabil dezakezu saio-hasiera bakarrerako "
"(SSO)."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "Popular CMS softwares (Wordpess, ...) offers plugins implementing OpenID Connect."
msgstr ""
"CMS software ezagunek (Wordpress, ...) OpenID Connect inplementatzen duten "
"pluginak eskaintzen dituzte."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "To enable this feature, first you have to create a client on your provider side (check the related documentation for enabling OpenID Connect).  Then go to the [plugin settings](/peertube-plugin-livechat/documentation/admin/settings), and enable \"{{% livechat_label external_auth_custom_oidc_label %}}\"."
msgstr ""
"Eginbide hau gaitzeko, lehenik bezero bat sortu behar duzu zure "
"hornitzailearen aldean (ikusi OpenID Connect gaitzeko dagokion dokumentazioa)"
".  Ondoren, joan [osagarriaren ezarpenetara](/peertube-plugin-livechat/"
"documentation/admin/settings), eta gaitu \"{{% livechat_label "
"external_auth_custom_oidc_label %}}\"."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "Note: if you want to restrict allowed redirection urls on the provider side (best security practice), the plugin will show you the url to allow.  Just copy it in your OpenID Connect application configuration."
msgstr ""
"Oharra: hornitzailearen aldean baimendutako birbideratze-URLak mugatu nahi "
"badituzu (segurtasun-praktika onena), osagarriak baimendu beharreko URLa "
"erakutsiko dizu.  Kopiatu zure OpenID Connect aplikazioaren konfigurazioan, "
"besterik ez."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "You will now have to fill some settings."
msgstr "Orain ezarpen batzuk bete beharko dituzu."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "This is the button label in the following screenshot:"
msgstr "Hau da hurrengo pantaila-argazkiko botoiaren etiketa:"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "For now, it is not possible to localize this label."
msgstr "Oraingoz, ezin da etiketa hau lokalizatu."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "Your OpenID Connect provider must implement the [discovery URL](https://openid.net/specs/openid-connect-discovery-1_0.html).  Just set here the discovery url, that should be something like `https://example.com/.well-known/openid-configuration`."
msgstr ""
"Zure OpenID Connect hornitzaileak [aurkikuntza-URLa](https://openid.net/"
"specs/openid-connect-discovery-1_0.html) inplementatu behar du.  Ezarri "
"hemen aurkikuntza-URLa, `https://example.com/.well-known/openid-"
"configuration` bezalako zerbait izan beharko lukeena."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "Note: if your provider use the standard `/.well-known/openid-configuration` path, you can omit it.  For example `https://accounts.google.com` will work."
msgstr ""
"Oharra: zure hornitzaileak `/.well-known/openid-configuration` bide "
"estandarra erabiltzen badu, ken dezakezu.  Adibidez, `https://"
"accounts.google.com` erabiliz gero funtzionatuko du."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "Your application Client ID."
msgstr "Zure aplikazioaren bezero-IDa."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "You application Client secret."
msgstr "Zure aplikazioaren bezero-sekretua."

#. type: Title ###
#: build/documentation/pot_in/documentation/admin/external_auth.md
#, no-wrap
msgid "Google, Facebook, ..."
msgstr "Google, Facebook, ..."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "In addition to that, you can also configure one or several \"standard\" Open ID Connect provider (Google, Facebook, ...)."
msgstr ""
"Horrez gain, OpenID Connect hornitzaile \"estandar\" bat edo gehiago ere "
"konfigura ditzakezu (Google, Facebook, ...)."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "For these providers, discovery url and button label are preset.  You just have to create an OAuth2 application on the provider side, and configure Client ID and Client Secret."
msgstr ""
"Hornitzaile hauetarako, aurkikuntza-URLa eta botoiaren etiketa aurrez "
"ezarrita daude.  OAuth2 aplikazio bat sortu besterik ez duzu egin behar "
"hornitzailearen aldean, eta bezero-IDa eta bezero-sekretua konfiguratu."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "If you think of a standard provider that is not available, you can ask for implementation by [opening a new issue](https://github.com/JohnXLivingston/peertube-plugin-livechat/issues)."
msgstr ""
"Erabilgarri ez dagoen hornitzaile estandarren bat bururatzen bazaizu, "
"inplementatzeko eska dezakezu [arazo-txosten berri bat irekiz](https://"
"github.com/JohnXLivingston/peertube-plugin-livechat/issues)."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "If the button does not appear for end users, there might be a configuration issue.  You can try the [diagnostic tool](/peertube-plugin-livechat/documentation/installation/troubleshooting/) to get more information."
msgstr ""
"Botoia ez bazaie azken erabiltzaileei agertzen, baliteke konfigurazio-"
"arazoren bat egotea.  [Diagnostiko-tresna](/peertube-plugin-livechat/"
"documentation/installation/troubleshooting/) erabil dezakezu informazio "
"gehiago lortzeko."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "Note: if you are connected to your Peertube account, the button will never show. So use a private browser window to test."
msgstr ""
"Oharra: zure PeerTube kontuan konektatuta bazaude, botoia ez da inoiz "
"agertuko. Beraz, erabili nabigatzailearen leiho pribatu bat probatzeko."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "If the button is displayed but is not working, check your Peertube logs.  It could be because the remote service does not use standard scopes or attribute names."
msgstr ""
"Botoia agertzen bada baina ez badabil, begiratu zure PeerTube erregistroak.  "
"Baliteke urruneko zerbitzuak esparru edo atributu-izen estandarrak ez "
"erabiltzea."

#. type: Title ##
#: build/documentation/pot_in/documentation/admin/external_auth.md
#, no-wrap
msgid "More to come"
msgstr "Gehiago etortzeko"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/external_auth.md
msgid "Other authentication methods will be implemented in the future."
msgstr "Etorkizunean beste autentifikazio-metodo batzuk inplementatuko dira."

#. type: Yaml Front Matter Hash Value: description
#: support/documentation/content/en/documentation/admin/_index.md
#, no-wrap
msgid "Plugin Peertube Livechat administration"
msgstr "PeerTube Livechat osagarriaren administrazioa"

#. type: Yaml Front Matter Hash Value: title
#: support/documentation/content/en/documentation/admin/_index.md
#, no-wrap
msgid "Admin documentation"
msgstr "Administrazio-dokumentazioa"

#. type: Yaml Front Matter Hash Value: description
#: support/documentation/content/en/documentation/admin/mod_firewall.md
#, no-wrap
msgid "Advanced firewall rules for the Prosody server"
msgstr "Prosody zerbitzariaren suebaki-arau aurreratuak"

#. type: Yaml Front Matter Hash Value: title
#: support/documentation/content/en/documentation/admin/mod_firewall.md
#, no-wrap
msgid "Prosody mod_firewall"
msgstr "Prosody mod_firewall"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/mod_firewall.md
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "You can enable [mod_firewall](https://modules.prosody.im/mod_firewall) on your Prosody server."
msgstr ""
"[mod_firewall](https://modules.prosody.im/mod_firewall) gai dezakezu zure "
"Prosody zerbitzarian."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/mod_firewall.md
msgid "Doing so, Peertube admins will be able to define advanced firewall rules."
msgstr ""
"Horrela, PeerTubeko administratzaileek suebaki-arau aurreratuak definitu "
"ahal izango dituzte."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/mod_firewall.md
msgid "These rules could be used to run arbitrary code on the server.  If you are a hosting provider, and you don't want to allow Peertube admins to write such rules, you can disable the online editing by creating a `disable_mod_firewall_editing` file in the plugin directory (`plugins/data/peertube-plugin-livechat/disable_mod_firewall_editing`).  This is opt-out, as Peertube admins can already run arbitrary code just by installing any plugin.  You can still use mod_firewall by editing files directly on the server."
msgstr ""
"Arau hauek zerbitzarian kode arbitrarioa exekutatzeko erabil litezke.  "
"Ostatu-hornitzailea bazara eta ez baduzu nahi PeerTubeko administratzaileek "
"horrelako arauak idaztea, lineako edizioa desgai dezakezu "
"`disable_mod_firewall_editing` fitxategi bat sortuz osagarriaren "
"direktorioan (`plugins/data/peertube-plugin-livechat/"
"disable_mod_firewall_editing`).  Aukera hau esplizituki desgaitu behar da, "
"PeerTubeko administratzaileek dagoeneko kode arbitrarioa exekuta baitezakete "
"edozein osagarri instalatuz.  Hala ere, mod_firewall erabil dezakezu "
"fitxategiak zuzenean zerbitzarian editatuz."

#. type: Title ##
#: support/documentation/content/en/documentation/admin/mod_firewall.md
#, no-wrap
msgid "Edit rules"
msgstr "Editatu arauak"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/mod_firewall.md
msgid "First, you must enable the feature in the [plugin settings](/peertube-plugin-livechat/documentation/admin/settings)."
msgstr ""
"Lehenik, eginbidea gaitu behar duzu [osagarriaren ezarpenetan](/peertube-"
"plugin-livechat/documentation/admin/settings)."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/mod_firewall.md
msgid "Just bellow the settings, you will find a \"Configure mod_firewall\" button.  This button will open a configuration page."
msgstr ""
"Ezarpenen azpian, \"Konfiguratu mod_firewall\" botoi bat aurkituko duzu.  "
"Botoi honek konfigurazio-orri bat irekiko du."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/mod_firewall.md
msgid "![Screenshot of the \"{{% livechat_label prosody_firewall_configuration %}}\" form.](/peertube-plugin-livechat/images/mod_firewall.png?classes=shadow,border&height=400px \"{{% livechat_label prosody_firewall_configuration %}}\")"
msgstr ""
"![\"{{% livechat_label prosody_firewall_configuration %}}\" inprimakiaren "
"pantaila-argazkia.](/peertube-plugin-livechat/images/"
"mod_firewall.png?classes=shadow,border&height=400px \"{{% livechat_label "
"prosody_firewall_configuration %}}\")"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/mod_firewall.md
msgid "Here you can add several configuration files."
msgstr "Hemen hainbat konfigurazio-fitxategi gehi ditzakezu."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/mod_firewall.md
msgid "You can enable/disable each files."
msgstr "Fitxategi bakoitza gai/desgai dezakezu."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/mod_firewall.md
msgid "Files will be loaded in the alphabetical order.  You can use a number as prefix to easily choose the order."
msgstr ""
"Fitxategiak ordena alfabetikoan kargatuko dira.  Zenbaki bat erabil dezakezu "
"aurrizki gisa ordena erraz aukeratzeko."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/mod_firewall.md
msgid "You can also edit these firewall rules directly on the server, in the `plugins/data/peertube-plugin-livechat/prosody/mod_firewall_config/` directory.  File names must only contains alphanumerical characters, underscores and hyphens.  The extension must be `.pfw`, or `.pfw.disabled` if you want to disable a file.  Please be sure that the peertube system user has write access to these files, else the web editing interface will fail.  Once you have edited these files, you must reload prosody.  This can be done by saving the plugin settings, or saving the mod_firewall configuration in the web interface, or by restarting Peertube."
msgstr ""
"Suebaki-arau hauek zuzenean zerbitzarian ere edita ditzakezu, `plugins/data/"
"peertube-plugin-livechat/prosody/mod_firewall_config/` direktorioan.  "
"Fitxategi-izenek karaktere alfanumerikoak, azpimarrak eta marratxoak soilik "
"izan ditzakete.  Luzapenak `.pfw` izan behar du, edo `.pfw.disabled` "
"fitxategi bat desgaitu nahi baduzu.  Ziurtatu peertube sistema-"
"erabiltzaileak fitxategi hauetan idazteko sarbidea duela; bestela, web "
"bidezko edizio-interfazeak huts egingo du.  Fitxategi hauek editatu ondoren, "
"prosody birkargatu behar duzu.  Hori egin daiteke osagarriaren ezarpenak "
"gordez, mod_firewall konfigurazioa web-interfazean gordez, edo PeerTube "
"berrabiaraziz."

#. type: Plain text
#: support/documentation/content/en/documentation/admin/mod_firewall.md
msgid "When you save the configuration, the server will automatically reload it, and your rules will apply immediatly.  You can check that there is no parsing error in the Prosody error log.  To do so, you can read the `plugins/data/peertube-plugin-livechat/prosody/prosody.err` file, or use the [diagnostic tool](/peertube-plugin-livechat/documentation/installation/troubleshooting/) that will show last Prosody errors."
msgstr ""
"Konfigurazioa gordetzean, zerbitzariak automatikoki birkargatuko du, eta "
"zure arauak berehala aplikatuko dira.  Prosodyren errore-erregistroan "
"analisi-errorerik ez dagoela egiazta dezakezu.  Horretarako, `plugins/data/"
"peertube-plugin-livechat/prosody/prosody.err` fitxategia irakur dezakezu, "
"edo Prosodyren azken erroreak erakutsiko dituen [diagnostiko-tresna](/"
"peertube-plugin-livechat/documentation/installation/troubleshooting/) "
"erabili."

#. type: Title ##
#: support/documentation/content/en/documentation/admin/mod_firewall.md
#, no-wrap
msgid "Examples"
msgstr "Adibideak"

#. type: Plain text
#: support/documentation/content/en/documentation/admin/mod_firewall.md
msgid "Don't hesitate to share your rules.  To do so, you can for example edit this [page](/peertube-plugin-livechat/contributing/document/#write-documentation)."
msgstr ""
"Ez izan zalantzarik zure arauak partekatzeko.  Horretarako, adibidez, [orri]"
"(/peertube-plugin-livechat/contributing/document/#write-documentation) hau "
"edita dezakezu."

#. type: Yaml Front Matter Hash Value: description
#: build/documentation/pot_in/documentation/admin/settings.md
#, no-wrap
msgid "Plugin Peertube Livechat settings"
msgstr "PeerTube Livechat osagarriaren ezarpenak"

#. type: Yaml Front Matter Hash Value: title
#: build/documentation/pot_in/documentation/admin/settings.md
#, no-wrap
msgid "Settings"
msgstr "Ezarpenak"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "This section describes the plugin settings page."
msgstr "Atal honek osagarriaren ezarpen-orria deskribatzen du."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "For more information on this feature, check the documentation for [channel's terms & conditions](/peertube-plugin-livechat/documentation/user/streamers/terms)."
msgstr ""
"Eginbide honi buruzko informazio gehiagorako, ikusi [kanalaren baldintzei](/"
"peertube-plugin-livechat/documentation/user/streamers/terms) buruzko "
"dokumentazioa."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "Changing this setting will restart the chat server, and all users will be disconnected for a short time."
msgstr ""
"Ezarpen hau aldatzeak txat-zerbitzaria berrabiaraziko du, eta erabiltzaile "
"guztiak deskonektatuta egongo dira denbora laburrez."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "When pressing the «List rooms» button, all existing chatrooms will be listed.  You can then find them and moderated them."
msgstr ""
"«Zerrendatu gelak» botoia sakatzean, dauden txat-gela guztiak zerrendatuko "
"dira.  Ondoren, haiek aurkitu eta moderatu ditzakezu."

#. type: Title ##
#: build/documentation/pot_in/documentation/admin/settings.md
#: support/documentation/content/en/intro/_index.md
#, no-wrap
msgid "Federation"
msgstr "Federazioa"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "Following settings concern the federation with other Peertube instances, and other fediverse softwares."
msgstr ""
"Ezarpen hauek beste PeerTube instantzia batzuekin eta fedibertsoko beste "
"software batzuekin egiten den federazioari dagozkio."

#. type: Title ##
#: build/documentation/pot_in/documentation/admin/settings.md
#, no-wrap
msgid "Authentication"
msgstr "Autentifikazioa"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "In case you have any trouble with the long term authentication tokens, you can disable the feature here."
msgstr ""
"Iraupen luzeko autentifikazio-tokenekin arazoren bat baduzu, eginbidea hemen "
"desgai dezakezu."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "See the detailed documentation page:"
msgstr "Ikusi dokumentazio-orri xehatua:"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "[External Authentication](/peertube-plugin-livechat/documentation/admin/external_auth/)"
msgstr ""
"[Kanpoko autentifikazioa](/peertube-plugin-livechat/documentation/admin/"
"external_auth/)"

#. type: Title ##
#: build/documentation/pot_in/documentation/admin/settings.md
#, no-wrap
msgid "Channel advanced configuration"
msgstr "Kanalaren konfigurazio aurreratua"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "Following settings concern the advanced channel options: users will be able to add some customization on their channels, activate the moderation bot, ..."
msgstr ""
"Ezarpen hauek kanalaren aukera aurreratuei dagozkie: erabiltzaileek "
"pertsonalizazio batzuk gehitu ahal izango dituzte beren kanaletan, moderazio-"
"bota gaitu, ..."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "If you encounter any issue with this feature, you can disable it."
msgstr "Eginbide honekin arazoren bat baduzu, desgai dezakezu."

#. type: Title ##
#: build/documentation/pot_in/documentation/admin/settings.md
#, no-wrap
msgid "Chat behaviour"
msgstr "Txataren portaera"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "This feature enables a «share chat link» modal. With this modal, you can generate URLs to join the chat.  The chat can be customized (readonly mode, use the current theme, ...)."
msgstr ""
"Eginbide honek «partekatu txataren esteka» leiho modal bat gaitzen du. Leiho "
"horrekin, txatera sartzeko URLak sor ditzakezu.  Txata pertsonaliza daiteke "
"(irakurtzeko soilik modua, uneko gaia erabili, ...)."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "You can for example generate a readonly URL and use it in OBS to integrate the chat in your live stream!"
msgstr ""
"Adibidez, irakurtzeko soilik den URL bat sor dezakezu eta OBSn erabili txata "
"zure zuzeneko igorpenean integratzeko!"

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "This setting allows you to choose who can access this modal."
msgstr ""
"Ezarpen honek leiho modal honetara nork sar daitekeen aukeratzeko aukera "
"ematen dizu."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "The video owner will be able to activate web chats."
msgstr "Bideoaren jabeak txatak gaitu ahal izango ditu."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
msgid "Note: for now this feature simply hide the chat.  In a future release, the chat will be replaced by a message saying «please log in to [...]».  See [v5.7.0 Release Notes](https://github.com/JohnXLivingston/peertube-plugin-livechat/blob/main/CHANGELOG.md#570) for more information."
msgstr ""
"Oharra: oraingoz eginbide honek txata ezkutatu besterik ez du egiten.  "
"Etorkizuneko bertsio batean, txata «hasi saioa [...]» dioen mezu batekin "
"ordeztuko da.  Ikusi [v5.7.0 bertsio-oharrak](https://github.com/"
"JohnXLivingston/peertube-plugin-livechat/blob/main/CHANGELOG.md#570) "
"informazio gehiagorako."

#. type: Plain text
#: build/documentation/pot_in/documentation/admin/settings.md
#, no-wrap
msgid ""
"**Important note**:\n"
"If you enable this feature, and are using a custom reverse proxy on front of Peertube, please make sure that your setup is correctly configured to forward real user's IPs to Peertube.\n"
"Otherwise it could block all anonymous users at once.\n"
msgstr ""
"**Ohar garrantzitsua**:\n"
"Eginbide hau gaitzen baduzu eta PeerTuberen aurrean alderantzizko proxy "
"pertsonalizatu bat erabiltzen baduzu, ziurtatu zure konfigurazioak "
"erabiltzaileen benetako IPak PeerTubera behar bezala birbidaltzen dituela.\n"
"Bestela, erabiltzaile anonimo guztiak batera blokea ditzake.\n"

